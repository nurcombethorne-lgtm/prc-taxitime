# OpenSky MinIO credentials for the PRC Data Challenge 2026.
#
# How to get these:
#   1. Go to https://s3.opensky-network.org (MinIO console)
#   2. Click "Other Authentication Methods" -> "Login with SSO"
#      and sign in with your OpenSky account (Keycloak)
#   3. In the console: Access Keys -> Create Access Key
#   4. Copy the pair into a file named `.env` next to this one
#
# `.env` is gitignored. Never commit real keys.

PRC_S3_ENDPOINT=https://s3.opensky-network.org
PRC_S3_ACCESS_KEY=
PRC_S3_SECRET_KEY=

# Team bucket (from the approval email)
PRC_TEAM_NAME=resilient-kiwi
PRC_TEAM_BUCKET=prc-2026-resilient-kiwi
