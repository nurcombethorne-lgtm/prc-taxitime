# OpenSky MinIO credentials for the PRC Data Challenge 2026.
#
# How to get these:
#   1. Go to https://s3-console.opensky-network.org  (the MinIO console —
#      NOT s3.opensky-network.org:9443, which is unreachable)
#   2. Click "Other Authentication Methods" -> "Login with SSO"
#      and sign in with your OpenSky account (Keycloak)
#   3. In the console: Access Keys -> Create access key -> Create
#   4. Copy the Access Key and Secret Key into a file named `.env`
#      next to this one (the secret is shown only once)
#
# `.env` is gitignored. Never commit real keys.

PRC_S3_ENDPOINT=https://s3.opensky-network.org
PRC_S3_ACCESS_KEY=
PRC_S3_SECRET_KEY=

# Team bucket (from the approval email)
PRC_TEAM_NAME=resilient-kiwi
PRC_TEAM_BUCKET=prc-2026-resilient-kiwi
